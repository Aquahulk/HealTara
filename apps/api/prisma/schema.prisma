generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                @id @default(autoincrement())
  email                  String             @unique
  password               String
  role                   String
  doctorCode             String?            @unique @map("doctor_code")
  staffCode              String?            @unique @map("staff_code")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  managedDoctorProfileId Int?               @map("managed_doctor_profile_id")
  managedHospitalId      Int?               @map("managed_hospital_id")
  canLogin               Boolean            @default(true) @map("can_login")
  status                 String             @default("ACTIVE") // ACTIVE, SUSPENDED
  adminAuditLogs         AdminAuditLog[]
  doctorAppointments     Appointment[]      @relation("DoctorAppointments")
  patientAppointments    Appointment[]      @relation("PatientAppointments")
  doctorEngagements      DoctorEngagement[] @relation("UserDoctorEngagements")
  doctorProfile          DoctorProfile?     @relation("UserDoctorProfile")
  patientProfile         PatientProfile?
  adminHospitals         Hospital[]         @relation("UserAdminHospitals")
  hospitalMemberships    HospitalDoctor[]   @relation("UserHospitalDoctor")
  doctorSlots            Slot[]             @relation("UserDoctorSlots")
  managedDoctorProfile   DoctorProfile?     @relation("UserManagedDoctorProfile", fields: [managedDoctorProfileId], references: [id])
  managedHospital        Hospital?          @relation("UserManagedHospital", fields: [managedHospitalId], references: [id])
  savedItems             SavedItem[]
  staffProfile           StaffProfile?      @relation("UserStaffProfile")
  initiatedRequests      StaffAssignmentRequest[] @relation("RequestInitiator")
  approvedRequestsDoctor StaffAssignmentRequest[] @relation("RequestDoctorApprover")
  approvedRequestsHospital StaffAssignmentRequest[] @relation("RequestHospitalApprover")
  rejectedRequests       StaffAssignmentRequest[] @relation("RequestRejector")
  doctorStaffRequests    StaffAssignmentRequest[] @relation("DoctorStaffRequests")
  doctorStaffAssignments StaffAssignment[]  @relation("DoctorStaffAssignments")
  revokedAssignments     StaffAssignment[]  @relation("AssignmentRevoker")
  auditActions           StaffAssignmentAuditLog[]

  @@map("users")
}

model SavedItem {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  entityType String   @map("entity_type") // 'doctor' or 'hospital'
  entityId   Int      @map("entity_id")   // ID of the doctor or hospital
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("saved_items")
}

model DoctorProfile {
  id                Int                  @id @default(autoincrement())
  userId            Int                  @unique @map("user_id")
  specialization    String
  qualifications    String?
  experience        Int?
  clinicName        String?              @map("clinic_name")
  clinicAddress     String               @map("clinic_address")
  city              String?
  state             String?
  phone             String
  consultationFee   Int                  @map("consultation_fee")
  latitude          Float?               @map("latitude")
  longitude         Float?               @map("longitude")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  slug              String?              @unique
  slotPeriodMinutes Int                  @default(15) @map("slot_period_minutes")
  previousSlotPeriodMinutes Int?        @map("previous_slot_period_minutes")
  slotPeriodUpdatedAt DateTime?          @map("slot_period_updated_at")
  micrositeEnabled  Boolean              @default(true) @map("microsite_enabled")
  profileImage      String?              @map("profile_image")
  registrationNumber String?             @map("registration_number")
  verificationSubmitted Boolean          @default(false) @map("verification_submitted")
  verificationStatus String              @default("PENDING") @map("verification_status") // PENDING, APPROVED, REJECTED
  features          Json?                @default("{}") @map("features") // Feature flags: { onlineBooking, microsite, reviews, analytics, walkin, slotManagement }
  user              User                 @relation("UserDoctorProfile", fields: [userId], references: [id], onDelete: Cascade)
  timeOffs          DoctorTimeOff[]
  workingHours      DoctorWorkingHours[]
  slotAdmins        User[]               @relation("UserManagedDoctorProfile")

  @@map("doctor_profiles")
}

model PatientProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  name        String?
  age         Int?
  gender      String?
  phone       String?
  address     String?
  city        String?
  state       String?
  bloodGroup  String?  @map("blood_group")
  allergies   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model DoctorTimeOff {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  start           DateTime
  end             DateTime
  reason          String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@map("doctor_time_offs")
}

model DoctorWorkingHours {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int           @map("doctor_profile_id")
  dayOfWeek       Int           @map("day_of_week")
  startTime       String        @map("start_time")
  endTime         String        @map("end_time")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, dayOfWeek])
  @@map("doctor_working_hours")
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime @map("appointment_date")
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  doctorId  Int      @map("doctor_id")
  patientId Int      @map("user_id")
  notes     String?
  time      String
  doctor    User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, date, status])
  @@index([patientId, date])
  @@index([date, time])
  @@map("appointments")
}

model Hospital {
  id          Int              @id @default(autoincrement())
  name        String
  hospitalCode String?         @unique @map("hospital_code")
  subdomain   String?          @unique
  address     String?
  city        String?
  state       String?
  phone       String?
  profile     Json?
  latitude    Float?           @map("latitude")
  longitude   Float?           @map("longitude")
  status      String           @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  registrationNumberGov String? @map("registration_number_gov")
  verificationSubmitted Boolean @default(false) @map("verification_submitted")
  verificationStatus    String  @default("PENDING") @map("verification_status") // PENDING, APPROVED, REJECTED
  features              Json?   @default("{}") @map("features") // Feature flags: { onlineBooking, microsite, reviews, analytics, departments, patientPortal }
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  adminId     Int?             @map("admin_id")
  departments Department[]
  admin       User?            @relation("UserAdminHospitals", fields: [adminId], references: [id])
  doctors     HospitalDoctor[]
  slotAdmins  User[]           @relation("UserManagedHospital")
  staffAssignmentRequests StaffAssignmentRequest[]
  staffAssignments StaffAssignment[]

  @@map("hospitals")
}

model Department {
  id          Int              @id @default(autoincrement())
  hospitalId  Int              @map("hospital_id")
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors     HospitalDoctor[]

  @@map("departments")
}

model HospitalDoctor {
  id           Int         @id @default(autoincrement())
  hospitalId   Int         @map("hospital_id")
  doctorId     Int         @map("doctor_id")
  departmentId Int?        @map("department_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  doctor       User        @relation("UserHospitalDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, doctorId])
  @@map("hospital_doctors")
}

model Slot {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  date      DateTime
  time      String
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  doctor    User     @relation("UserDoctorSlots", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date, time])
  @@index([doctorId, date, status])
  @@index([date, status])
  @@index([status, time])
  @@map("slots")
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_audit_logs")
}

model DoctorEngagement {
  id         Int      @id @default(autoincrement())
  doctorId   Int      @map("doctor_id")
  date       DateTime @default(now())
  cardViews  Int      @default(0) @map("card_views")
  siteClicks Int      @default(0) @map("site_clicks")
  bookClicks Int      @default(0) @map("book_clicks")
  doctor     User     @relation("UserDoctorEngagements", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@map("doctor_engagements")
}

model SearchAnalytics {
  id                 Int      @id @default(autoincrement())
  query              String
  normalizedQuery    String   @map("normalized_query")
  matchedConditions  String[] @map("matched_conditions")
  matchedSpecialties String[] @map("matched_specialties")
  topRankedDoctorId  Int?     @map("top_ranked_doctor_id")
  clickedDoctorId    Int?     @map("clicked_doctor_id")
  meta               Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([normalizedQuery])
  @@index([topRankedDoctorId])
  @@index([clickedDoctorId])
  @@map("search_analytics")
}

model Comment {
  id          Int       @id @default(autoincrement())
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  userId      Int?      @map("user_id")
  name        String
  email       String
  rating      Int?
  comment     String
  parentId    Int?      @map("parent_id")
  isVerified  Boolean   @default(true) @map("is_verified")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   Int?      @map("deleted_by")

  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  @@index([entityType, entityId])
  @@map("comments")
}


// ============================================================================
// 🏥 SLOT ADMINISTRATOR SYSTEM - Phase 1: Identity Foundation
// ============================================================================

model StaffProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  staffCode  String   @unique @map("staff_code")
  name       String
  phone      String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  user       User     @relation("UserStaffProfile", fields: [userId], references: [id], onDelete: Cascade)
  assignmentRequests StaffAssignmentRequest[]
  assignments StaffAssignment[]
  
  @@map("staff_profiles")
}

model StaffAssignmentRequest {
  id                    Int       @id @default(autoincrement())
  staffId               Int       @map("staff_id")
  doctorId              Int?      @map("doctor_id")
  hospitalId            Int?      @map("hospital_id")
  scope                 String
  initiatedBy           Int       @map("initiated_by")
  status                String    @default("PENDING")
  doctorApprovedAt      DateTime? @map("doctor_approved_at")
  doctorApprovedBy      Int?      @map("doctor_approved_by")
  hospitalApprovedAt    DateTime? @map("hospital_approved_at")
  hospitalApprovedBy    Int?      @map("hospital_approved_by")
  staffAcceptedAt       DateTime? @map("staff_accepted_at")
  rejectionReason       String?   @map("rejection_reason")
  rejectionBy           Int?      @map("rejection_by")
  rejectedAt            DateTime? @map("rejected_at")
  expiresAt             DateTime  @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  
  staff                 StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  doctor                User?        @relation("DoctorStaffRequests", fields: [doctorId], references: [id], onDelete: Cascade)
  hospital              Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  initiator             User         @relation("RequestInitiator", fields: [initiatedBy], references: [id])
  doctorApprover        User?        @relation("RequestDoctorApprover", fields: [doctorApprovedBy], references: [id])
  hospitalApprover      User?        @relation("RequestHospitalApprover", fields: [hospitalApprovedBy], references: [id])
  rejector              User?        @relation("RequestRejector", fields: [rejectionBy], references: [id])
  assignment            StaffAssignment?
  auditLogs             StaffAssignmentAuditLog[]
  
  @@index([staffId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
  @@index([expiresAt])
  @@map("staff_assignment_requests")
}

model StaffAssignment {
  id                Int       @id @default(autoincrement())
  requestId         Int?      @unique @map("request_id")
  staffId           Int       @map("staff_id")
  doctorId          Int?      @map("doctor_id")
  hospitalId        Int?      @map("hospital_id")
  scope             String
  status            String    @default("ACTIVE")
  activatedAt       DateTime  @default(now()) @map("activated_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedBy         Int?      @map("revoked_by")
  revocationReason  String?   @map("revocation_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  request           StaffAssignmentRequest? @relation(fields: [requestId], references: [id])
  staff             StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  doctor            User?        @relation("DoctorStaffAssignments", fields: [doctorId], references: [id], onDelete: Cascade)
  hospital          Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  revoker           User?        @relation("AssignmentRevoker", fields: [revokedBy], references: [id])
  permissions       StaffAssignmentPermission[]
  auditLogs         StaffAssignmentAuditLog[]
  
  @@unique([staffId, doctorId, hospitalId, scope])
  @@index([staffId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([status])
  @@index([scope])
  @@map("staff_assignments")
}

model StaffAssignmentPermission {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  permission   String
  granted      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  
  assignment   StaffAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  @@unique([assignmentId, permission])
  @@index([assignmentId])
  @@map("staff_assignment_permissions")
}

model StaffAssignmentAuditLog {
  id           Int      @id @default(autoincrement())
  assignmentId Int?     @map("assignment_id")
  requestId    Int?     @map("request_id")
  action       String
  actorId      Int      @map("actor_id")
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  
  assignment   StaffAssignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  request      StaffAssignmentRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor        User                     @relation(fields: [actorId], references: [id])
  
  @@index([assignmentId])
  @@index([requestId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("staff_assignment_audit_logs")
}
